# AI Debate Lab 환경변수 예시 파일 (Git에 커밋됨)
#
# 사용 방법:
#   1. 이 파일을 복사해 같은 폴더에 .env.local 파일을 만듭니다.
#   2. .env.local 에 실제 키를 붙여 넣습니다. (.env.local 은 .gitignore로 Git에서 제외됨)
#   3. 개발 서버(npm run dev)를 다시 시작합니다.
#
# 이 파일(.env.example)에는 절대 실제 키를 넣지 마세요.
# NEXT_PUBLIC_ 접두사를 붙이면 브라우저에 노출되므로 붙이지 마세요.

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# 대화형 토론의 첫 발언 모델을 정하는 서버 전용 비밀값 (32자 이상 무작위 문자열).
# 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 값을 바꾸면 같은 debateId라도 첫 발언 모델이 달라질 수 있으니, 정한 뒤에는 바꾸지 마세요.
DIALOGUE_SEED_SECRET=
